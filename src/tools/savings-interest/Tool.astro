---
import { t } from '../../i18n';
import Quip from '../../components/Quip.astro';
import type { Lang, ToolMeta } from '../../lib/types';
import { S } from './strings';

interface Props {
  lang: Lang;
  tool: ToolMeta;
}
const { lang } = Astro.props;
const s = S[lang];
---

<section class="tool" data-savings data-config={JSON.stringify({ lang, s, copied: t(lang).copied })}>
  <div class="grid">
    <div class="field">
      <label for="sv-amount">{s.amount}</label>
      <input id="sv-amount" type="text" inputmode="decimal" value={s.example.amount} data-amount />
    </div>
    <div class="field">
      <label for="sv-rate">{s.rate}</label>
      <input id="sv-rate" type="text" inputmode="decimal" value={s.example.rate} data-rate />
    </div>
    <div class="field">
      <label for="sv-term">{s.term}</label>
      <input id="sv-term" type="text" inputmode="numeric" value="12" data-term />
    </div>
  </div>
  <div class="stack" style="margin-top:16px">
    <span class="label" id="sv-method">{s.method}</span>
    <div class="segmented" role="radiogroup" aria-labelledby="sv-method">
      <label><input type="radio" name="sv-method" value="simple" checked data-method /><span>{s.simple}</span></label>
      <label><input type="radio" name="sv-method" value="monthly" data-method /><span>{s.monthly}</span></label>
    </div>
  </div>
  <div class="result" aria-live="polite">
    <span class="result-value result-big" data-value></span>
    <button type="button" class="btn btn-secondary btn-sm" data-copy>{t(lang).copy}</button>
    <span class="result-formula">{s.interest}</span>
  </div>
  <p class="error" data-error></p>
  <dl class="stats">
    <div><dt>{s.total}</dt><dd data-total>-</dd></div>
  </dl>
  <Quip icon="pig-money" />
</section>

<script>
  import { $, readConfig, setQuip, setupCopy } from '../../lib/client';
  import { band, fill } from '../../lib/quip';
  import { formatNumber, parseNumber } from '../../lib/number';
  import type { Lang } from '../../lib/types';
  import { savings, type SavingsMethod } from './logic';
  import type { SavingsStrings } from './strings';

  for (const root of document.querySelectorAll<HTMLElement>('[data-savings]')) {
    const { lang, s, copied } = readConfig<{ lang: Lang; s: SavingsStrings; copied: string }>(root);
    const num = (sel: string) => parseNumber($<HTMLInputElement>(root, sel).value, lang);
    const set = (sel: string, text: string) => ($(root, sel).textContent = text);
    const update = () => {
      const [amount, rate, term] = [num('[data-amount]'), num('[data-rate]'), num('[data-term]')];
      const method = root.querySelector<HTMLInputElement>('[data-method]:checked')!.value as SavingsMethod;
      const r = amount !== null && rate !== null && term !== null ? savings(amount, rate, term, method) : null;
      if (!r) {
        set('[data-value]', '-');
        set('[data-total]', '-');
        set('[data-error]', amount === null || rate === null || term === null ? s.errInvalid : s.errTerm);
        setQuip(root, '');
        return;
      }
      set('[data-error]', '');
      set('[data-value]', formatNumber(r.interest, lang, 2));
      set('[data-total]', formatNumber(r.total, lang, 2));
      // Cups = interest / s.cupPrice (35.000 đ per bubble tea in VI, 5 per coffee in EN); the line states the price.
      const cups = Math.floor(r.interest / s.cupPrice);
      let quip: string;
      if (amount === 0) quip = s.quipNoMoney;
      else if (rate === 0) quip = s.quipZeroRate;
      else if (cups < 1) quip = s.quipCrumbs;
      else quip = fill(band(r.interest / amount!, s.quips), { cups: formatNumber(cups, lang) });
      setQuip(root, quip);
    };
    root.addEventListener('input', update);
    root.addEventListener('change', update);
    setupCopy($<HTMLButtonElement>(root, '[data-copy]'), () => $(root, '[data-value]').textContent ?? '', copied);
    update();
  }
</script>

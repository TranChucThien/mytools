---
import type { FaqItem } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  heading: string;
  items: FaqItem[];
}
const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq">
      <h2>{heading}</h2>
      <div class="faq-list">
        {items.map((f) => (
          <details>
            <summary>
              {f.q}
              <Icon name="plus" size={20} />
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource/be-vietnam-pro/800.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Icon from '../components/Icon.astro';
import SeoHead from '../components/SeoHead.astro';
import { t } from '../i18n';
import { homePath, otherLang, TOOLS, toolPath } from '../lib/registry';
import { CATEGORIES, type Lang } from '../lib/types';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates?: Record<Lang, string>;
  jsonLd?: object[];
  noindex?: boolean;
}

const { lang, alternates, ...seo } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const switchTo = alternates?.[other] ?? homePath(other);
const FOOTER_LIMIT = 6;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} alternates={alternates} {...seo} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={homePath(lang)}>
          <span class="brand-mark"><Icon name="tool" size={20} /></span>
          <span>{s.siteName}</span>
        </a>
        <a class="header-link" href={`${homePath(lang)}#tools`}>{s.allTools}</a>
        <a class="lang-switch" href={switchTo} hreflang={other} lang={other}>
          <Icon name="language" size={16} />
          {s.langSwitchLabel}
        </a>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-cols">
          {
            CATEGORIES.map((cat) => {
              const tools = TOOLS.filter((tool) => tool.category === cat);
              return (
                tools.length > 0 && (
                  <div>
                    <h2>{s.categories[cat]}</h2>
                    <ul>
                      {tools.slice(0, FOOTER_LIMIT).map((tool) => (
                        <li>
                          <a href={toolPath(tool, lang)}>{tool.name[lang]}</a>
                        </li>
                      ))}
                      {tools.length > FOOTER_LIMIT && (
                        <li>
                          <a class="footer-more" href={`${homePath(lang)}#tools`}>
                            {s.seeAll} ({tools.length})
                          </a>
                        </li>
                      )}
                    </ul>
                  </div>
                )
              );
            })
          }
        </div>
        <p class="footer-note">{s.footerNote}</p>
        <p class="footer-note">© {new Date().getFullYear()} congcumienphi.id.vn</p>
      </div>
    </footer>
  </body>
</html>

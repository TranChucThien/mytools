---
import { toolPath } from '../lib/registry';
import type { Lang, ToolMeta } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  tool: ToolMeta;
  lang: Lang;
}
const { tool, lang } = Astro.props;
---

<li data-tool-tile data-search={`${tool.name.vi} ${tool.name.en} ${tool.slug.vi} ${tool.slug.en} ${tool.h1[lang]}`.toLowerCase()}>
  <a class="tile" href={toolPath(tool, lang)}>
    <span class="chip"><Icon name={tool.icon} size={22} /></span>
    <span class="tile-text">
      <strong>{tool.name[lang]}</strong>
      <span>{tool.intro[lang]}</span>
    </span>
  </a>
</li>

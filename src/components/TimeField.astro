---
/** Optional 24-hour time input (HH:mm). Empty means "no time given". Read it with `parseTimeText()`. */
import { t } from '../i18n';
import { TIME_PLACEHOLDER } from '../lib/date';
import type { Lang } from '../lib/types';

interface Props {
  id: string;
  label: string;
  lang: Lang;
  name: string;
  value?: string;
}
const { id, label, lang, name, value = '' } = Astro.props;
const attr = { [`data-${name}`]: true };
---

<div class="field">
  <label for={id}>{label} <span class="optional">({t(lang).optional})</span></label>
  <input
    id={id}
    type="text"
    inputmode="numeric"
    autocomplete="off"
    maxlength="8"
    placeholder={TIME_PLACEHOLDER}
    value={value}
    data-time-text
    {...attr}
  />
</div>

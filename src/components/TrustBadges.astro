---
import { t } from '../i18n';
import type { Lang } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const s = t(Astro.props.lang);
---

<ul class="badges">
  <li><Icon name="gift" size={16} />{s.badgeFree}</li>
  <li><Icon name="user-off" size={16} />{s.badgeNoSignup}</li>
  <li><Icon name="lock" size={16} />{s.badgeLocal}</li>
</ul>

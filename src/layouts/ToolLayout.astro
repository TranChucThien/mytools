---
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import RelatedTools from '../components/RelatedTools.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { t } from '../i18n';
import { getContent } from '../lib/content';
import { homePath, toolPath } from '../lib/registry';
import { breadcrumbLd, faqLd, webApplicationLd } from '../lib/seo';
import type { Lang, ToolMeta } from '../lib/types';
import { TOOL_ARTICLES, TOOL_COMPONENTS } from '../tools/components';
import BaseLayout from './BaseLayout.astro';

interface Props {
  tool: ToolMeta;
  lang: Lang;
}

const { tool, lang } = Astro.props;
const s = t(lang);
const content = getContent(tool.id, lang);
const faq = content ? (content.frontmatter.faq ?? []) : (tool.faq?.[lang] ?? []);
const Tool = TOOL_COMPONENTS[tool.component];
const Article = TOOL_ARTICLES[tool.component];

const crumbs = [
  { name: s.home, path: homePath(lang) },
  { name: tool.name[lang], path: toolPath(tool, lang) },
];
const jsonLd: object[] = [webApplicationLd(tool, lang), breadcrumbLd(crumbs)];
if (faq.length > 0) jsonLd.push(faqLd(faq));
---

<BaseLayout
  lang={lang}
  title={tool.title[lang]}
  description={tool.description[lang]}
  path={toolPath(tool, lang)}
  alternates={{ vi: toolPath(tool, 'vi'), en: toolPath(tool, 'en') }}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <div class="page-head">
    <h1><span class="chip chip-lg"><Icon name={tool.icon} size={28} /></span>{tool.h1[lang]}</h1>
    <p class="lead">{tool.intro[lang]}</p>
  </div>

  <div class="tool-layout">
    <div class="tool-main">
      <Tool lang={lang} tool={tool} />
      <noscript><p class="error">{s.noscript}</p></noscript>
      <TrustBadges lang={lang} />

      <AdSlot name="after-result" />

      <article class="prose">
        {content ? <content.Content /> : Article && <Article tool={tool} lang={lang} />}
      </article>

      <Faq heading={s.faqHeading} items={faq} />
    </div>
    <aside class="tool-aside">
      <RelatedTools tool={tool} lang={lang} heading={s.relatedHeading} />
    </aside>
  </div>
</BaseLayout>

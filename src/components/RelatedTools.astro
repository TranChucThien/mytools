---
import { relatedTools } from '../lib/registry';
import type { Lang, ToolMeta } from '../lib/types';
import ToolCard from './ToolCard.astro';

interface Props {
  tool: ToolMeta;
  lang: Lang;
  heading: string;
}
const { tool, lang, heading } = Astro.props;
const related = relatedTools(tool);
---

{
  related.length > 0 && (
    <nav aria-label={heading}>
      <h2 class="aside-title">{heading}</h2>
      <ul class="tiles">
        {related.map((r) => (
          <ToolCard tool={r} lang={lang} />
        ))}
      </ul>
    </nav>
  )
}
